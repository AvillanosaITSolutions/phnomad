generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  googleId      String         @unique
  name          String
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  visas         Visa[]
  subscription  Subscription?
  topUpTransactions TopUpTransaction[]
  renewalHistory VisaRenewalHistory[]
}

model Visa {
  id                String            @id @default(cuid())
  userId            String
  nationality       String
  country           String
  visaType          String
  entryDate         DateTime
  expiryDate        DateTime
  phoneNumber       String
  email             String
  smsEnabled        Boolean           @default(true)
  emailEnabled      Boolean           @default(true)
  reminderIntervals Int[]             @default([30, 14, 7, 3, 1])
  createdAt         DateTime          @default(now())
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationLogs  NotificationLog[]
  renewalHistory    VisaRenewalHistory[]

  @@index([userId])
  @@index([expiryDate])
}

model NotificationLog {
  id      String   @id @default(cuid())
  visaId  String
  type    NotificationType
  status  NotificationStatus
  provider String
  sentAt  DateTime @default(now())
  visa    Visa     @relation(fields: [visaId], references: [id], onDelete: Cascade)

  @@index([visaId])
  @@index([sentAt])
}

model VisaRenewalHistory {
  id                String   @id @default(cuid())
  userId            String
  visaId            String
  eventType         VisaRenewalEventType
  previousExpiryDate DateTime?
  newExpiryDate     DateTime
  note              String
  createdAt         DateTime @default(now())
  visa              Visa     @relation(fields: [visaId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([visaId])
  @@index([createdAt])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String   @unique
  provider    String   @default("paymongo")
  productId   String?
  entitlement String?
  status      String
  active      Boolean  @default(false)
  smsCredits  Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TopUpTransaction {
  id                String   @id @default(cuid())
  userId            String
  packageId         String
  paymongoPaymentId String   @unique
  checkoutSessionId String?
  amountPhp         Int
  credits           Int
  status            String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ScheduledTask {
  id             String   @id @default(cuid())
  name           String   @unique
  handler        String
  cronExpression  String
  timezone       String   @default("UTC")
  enabled        Boolean  @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum NotificationType {
  SMS
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum VisaRenewalEventType {
  CREATED
  RENEWED
}